{
  "editor.tabSize": 4,

  "files.eol": "\n",
  "files.exclude": {
    "node_modules/": true,
    "**/node_modules/": true,
    "**/dist/": true,
    "**/*.tsbuildinfo": true
  },

  "typescript.preferences.importModuleSpecifier": "relative",

  "rest-client.environmentVariables": {
    "$shared": {
      "baseUrl": "http://localhost:3000"
    }
  },

  "nodejs-testing.include": ["./**/**"],
  "nodejs-testing.extensions": [
    {
      "extensions": ["ts"],
      "filePatterns": ["**/*.test.ts"],
      "parameters": ["--env-file-if-exists=.env", "--import", "tsx"]
    }
  ]
}
