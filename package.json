{
  "name": "project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "flyway:migrate": "dotenv -e .env -- flyway -baselineOnMigrate=true migrate",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node --env-file=.env dist/server.js",
    "test": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:unit": "tsx --test 'src/**/*.unit.test.ts'",
    "test:int": "tsx --test 'src/**/*.int.test.ts'",
    "test:e2e": "dotenv -e .env -- tsx --test 'src/**/*.e2e.test.ts'",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check \"**/*.{ts,mjs,json}\"",
    "format": "prettier --write \"**/*.{ts,mjs,json}\""
  },
  "dependencies": {
    "@event-driven-io/emmett": "^0.43.0-beta.44",
    "@event-driven-io/emmett-expressjs": "^0.43.0-beta.44",
    "@event-driven-io/emmett-postgresql": "^0.43.0-beta.44",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.100.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "isomorphic-git": "^1.37.6",
    "jose": "^6.2.3",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "simple-git": "^3.36.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^11.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sql-formatter": "^15.7.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  }
}
